// https://zed.dev/docs/key-bindings
[
  // ═══════════════════════════════════════════════════════════════
  // 🌐 WORKSPACE (глобальные привязки, работают везде)
  // ═══════════════════════════════════════════════════════════════
  {
    "context": "Workspace",
    "bindings": {
      "space e": "project_panel::ToggleFocus", // Показать/скрыть панель проекта
      // "space g g": "git_panel::ToggleFocus", // Показать/скрыть Git панель (опционально)
      "space t": "terminal_panel::ToggleFocus", // Показать/скрыть терминал (опционально)
    },
  },

  // ═══════════════════════════════════════════════════════════════
  // 📝 EDITOR (привязки внутри редактора кода)
  // ═══════════════════════════════════════════════════════════════
  {
    "context": "Editor",
    "bindings": {
      "space enter": "editor::ToggleCodeActions", // Code actions / quick fixes
    },
  },

  // ═══════════════════════════════════════════════════════════════
  // 🎮 EDITOR + VIM NORMAL (только в нормальном режиме Vim)
  // ═══════════════════════════════════════════════════════════════
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // ───────────────────────────────────────────────────────────
      // 🗂️ Навигация по панелям (tabs)
      // ───────────────────────────────────────────────────────────
      "tab": "pane::ActivateNextItem",
      "shift-tab": "pane::ActivatePreviousItem",

      // ───────────────────────────────────────────────────────────
      // 🪟 Управление окнами
      // ───────────────────────────────────────────────────────────
      "space d d": "pane::CloseOtherItems",

      // ───────────────────────────────────────────────────────────
      // 🔍 Поиск и навигация
      // ───────────────────────────────────────────────────────────
      "space f f": "file_finder::Toggle",
    },
  },

  // ═══════════════════════════════════════════════════════════════
  // 📁 PROJECT PANEL (когда фокус на дереве файлов)
  // ═══════════════════════════════════════════════════════════════
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      // ───────────────────────────────────────────────────────────
      // 📄 Создание и редактирование файлов
      // ───────────────────────────────────────────────────────────
      "a": "project_panel::NewFile", // Новый файл
      "shift-a": "project_panel::NewDirectory", // Новая папка
      "r": "project_panel::Rename", // Переименовать
      "d": "project_panel::Delete", // Удалить

      // ───────────────────────────────────────────────────────────
      // 📋 Буфер обмена (стиль IDE)
      // ───────────────────────────────────────────────────────────
      "c": "project_panel::Copy", // Копировать
      "x": "project_panel::Cut", // Вырезать
      "v": "project_panel::Paste", // Вставить
      "p": "workspace::CopyPath", // Скопировать путь к файлу

      // ───────────────────────────────────────────────────────────
      // 🧭 Навигация и действия
      // ───────────────────────────────────────────────────────────
      "enter": "project_panel::Open", // Открыть файл/папку
      "space enter": "project_panel::Open", // Дубль для удобства (опционально)
    },
  },
]
