{
  // https://zed.dev/docs/reference/all-settings
  // ═══════════════════════════════════════════════════════════════
  // 🎨 ТЕМА И ШРИФТЫ (визуальное оформление)
  // ═══════════════════════════════════════════════════════════════
  "theme": "Catppuccin Mocha - No Italics",
  "ui_font_family": "DejaVu Sans",
  "buffer_font_family": "DejaVu Sans",
  "ui_font_size": 20.0,
  "buffer_font_size": 18.0,
  "agent_ui_font_size": 20.0,
  "agent_buffer_font_size": 20.0,
  "buffer_line_height": "standard",
  "buffer_font_weight": 400.0,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme",
  },

  // ═══════════════════════════════════════════════════════════════
  // ⌨️ ПОВЕДЕНИЕ РЕДАКТОРА (клавиши, курсор, ввод)
  // ═══════════════════════════════════════════════════════════════
  "vim_mode": true,
  "base_keymap": "VSCode",
  "multi_cursor_modifier": "cmd_or_ctrl",
  "show_completions_on_input": false,
  "inline_code_actions": false,
  "extend_comment_on_newline": false,
  "horizontal_scroll_margin": 4,
  "vertical_scroll_margin": 4,
  "close_on_file_delete": true,

  // ═══════════════════════════════════════════════════════════════
  // 🤖 AI-АГЕНТ
  // ═══════════════════════════════════════════════════════════════
  "agent": {
    "enabled": true,
    "default_model": {
      "provider": "openrouter",
      "model": "arcee-ai/trinity-large-preview:free",
    },
  },

  // ═══════════════════════════════════════════════════════════════
  // 🖥️ ИНТЕРФЕЙС: панели, заголовки, навигация
  // ═══════════════════════════════════════════════════════════════
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "project_panel": {
    "dock": "right",
    "default_width": 500,
    "hide_root": true,
    "git_status": false,
    "auto_fold_dirs": false,
  },
  "file_finder": {
    "modal_max_width": "medium",
  },
  "gutter": {
    "min_line_number_digits": 3,
  },

  // ═══════════════════════════════════════════════════════════════
  // 📁 УПРАВЛЕНИЕ ФАЙЛАМИ И ПРОЕКТОМ
  // ═══════════════════════════════════════════════════════════════
  "file_scan_exclusions": ["__pycache__", ".venv", ".env", ".git"],
  "auto_update": false,

  // ═══════════════════════════════════════════════════════════════
  // ✨ EDIT PREDICTIONS (автодополнение от Zed)
  // ═══════════════════════════════════════════════════════════════
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "disabled_globs": [
      "**/.env*",
      "**/*.pem",
      "**/*.key",
      "**/*.cert",
      "**/*.crt",
      "**/.dev.vars",
      "**/secrets.yml",
    ],
  },

  // ═══════════════════════════════════════════════════════════════
  // 🔒 КОНФИДЕНЦИАЛЬНОСТЬ И ТЕЛЕМЕТРИЯ
  // ═══════════════════════════════════════════════════════════════
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // ═══════════════════════════════════════════════════════════════
  // 🌿 GIT-ИНТЕГРАЦИЯ
  // ═══════════════════════════════════════════════════════════════
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "git_panel": {
    "tree_view": false,
  },

  // ═══════════════════════════════════════════════════════════════
  // 🐍 ЯЗЫКОВЫЕ НАСТРОЙКИ (Python)
  // ═══════════════════════════════════════════════════════════════
  "languages": {
    "Python": {
      "preferred_line_length": 120,
      "colorize_brackets": true,
      "language_servers": ["basedpyright", "ruff"],
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
    },
  },

  // ═══════════════════════════════════════════════════════════════
  // 🔧 LSP-СЕРВЕРЫ (детальная настройка)
  // ═══════════════════════════════════════════════════════════════
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          "typeCheckingMode": "all",
          "diagnosticMode": "workspace",
          "autoSearchPaths": true,
          "autoImportCompletions": true,
          "useLibraryCodeForTypes": true,
          "ignore": ["__pycache__"],
          "inlayHints": {
            "variableTypes": true,
            "functionReturnTypes": true,
            "callArgumentNames": true,
          },
          "diagnosticSeverityOverrides": {
            "reportExplicitAny": false,
            "reportAny": false,
            "reportUnknownParameterType": false,
            "reportUnknownArgumentType": false,
            "reportUnknownMemberType": false,
            "reportUnusedParameter": false,
            "reportUnusedCallResult": false,
            "reportIncompatibleVariableOverride": false,
            "reportImplicitOverride": false,
          },
        },
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lint": {
            "ignore": ["all"],
          },
        },
      },
    },
  },
}
